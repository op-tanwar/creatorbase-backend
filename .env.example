# ==============================================================================
# CreatorBase Backend API - Environment Configuration
# ==============================================================================

# Server Port
PORT=5000

# Node Environment
NODE_ENV=production

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL / Neon / Supabase / Railway)
# ------------------------------------------------------------------------------
# Neon Database Connection String:
# Create a free project at https://neon.tech, select your region (e.g. ap-southeast-1 or eu-central-1),
# and copy the pooled connection string (with -pooler and ?sslmode=require&pgbouncer=true):
DATABASE_URL="postgresql://user:pass@ep-cool-snowflake-123456-pooler.ap-southeast-1.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=30&pool_timeout=30"

# ------------------------------------------------------------------------------
# 2. JWT AUTHENTICATION
# ------------------------------------------------------------------------------
# Secret key used for signing JSON Web Tokens (min 32 characters for security)
JWT_SECRET="super-secure-jwt-secret-key-at-least-32-chars-creatorbase-production"

# ------------------------------------------------------------------------------
# 3. CORS & FRONTEND URL CONFIGURATION
# ------------------------------------------------------------------------------
# Local Development: "http://localhost:3000"
# Production (Vercel): "https://creatorbase.vercel.app" or comma-separated list of origins:
# e.g.: "http://localhost:3000,https://creatorbase.vercel.app,https://creatorbase-agency.vercel.app"
FRONTEND_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 4. RAZORPAY PAYMENT GATEWAY (PCI-DSS Compliant)
# ------------------------------------------------------------------------------
# Get your API keys from Razorpay Dashboard (Settings > API Keys):
RAZORPAY_KEY_ID="rzp_test_51aBcDeFgHiJkL"
RAZORPAY_KEY_SECRET="your_razorpay_secret"
# Webhook Secret from Razorpay Dashboard (Settings > Webhooks):
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"

# ------------------------------------------------------------------------------
# 5. APIFY INSTAGRAM SCRAPING ENGINE
# ------------------------------------------------------------------------------
# Get your API token from Apify Console (https://console.apify.com/account/integrations):
# Used to sync live Instagram creators, follower counts, reel views, and ER via 'apify/instagram-profile-scraper'.
APIFY_API_TOKEN="apify_api_your_token_here"

# ------------------------------------------------------------------------------
# 6. DEPLOYMENT INSTRUCTIONS
# ------------------------------------------------------------------------------
# Render (https://render.com):
#   - Build Command: npm install && npx prisma generate && npm run build
#   - Start Command: npm start
#   - Set Environment Variables: DATABASE_URL, JWT_SECRET, FRONTEND_URL, PORT=5000
#
# Railway (https://railway.app):
#   - Build Command: npm install && npx prisma generate && npm run build
#   - Start Command: npm start
#   - Set Environment Variables: DATABASE_URL, JWT_SECRET, FRONTEND_URL, PORT=5000
